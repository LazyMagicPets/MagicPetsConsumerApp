@namespace BlazorUI

<MudNavMenu>
    @* Href="" resolves to the app base (e.g. /app/) — the in-app Home route. Href="/" would
       point at the SITE root, leaving the SPA and hitting the base-href fatal when lz-explored
       is set. See CFRequest.js root-canonical redirect. *@
    <MudNavLink Href="" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Add">Home</MudNavLink>
    <AuthorizeView>
        <Authorized>
            <MudNavLink Href="PetsPage" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Add">Pets</MudNavLink>
        </Authorized>
    </AuthorizeView>
</MudNavMenu>
