{
  "profiles": {
    "https Cloud": {
      "commandName": "Project",
      "launchBrowser": true,
      "launchUrl": "app/",
      "environmentVariables": {
        "ASPNETCORE_PATHBASE": "/app"
      },
      "dotnetRunMessages": true,
      "inspectUri": "{wsProtocol}://{url.hostname}:{url.port}/app/_framework/debug/ws-proxy?browser={browserInspectUri}",
      "applicationUrl": "https://localhost:7218"
    },
    "https Local": {
      "commandName": "Project",
      "launchBrowser": true,
      "launchUrl": "app/",
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Localhost",
        "ASPNETCORE_PATHBASE": "/app"
      },
      "dotnetRunMessages": true,
      "inspectUri": "{wsProtocol}://{url.hostname}:{url.port}/app/_framework/debug/ws-proxy?browser={browserInspectUri}",
      "applicationUrl": "https://localhost:7218"
    }
  },
  "$schema": "http://json.schemastore.org/launchsettings.json"
}